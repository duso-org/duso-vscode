{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "fileTypes": [
    "du"
  ],
  "name": "Duso",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#multiline-strings"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#structures"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "builtins": {
      "patterns": [
        {
          "match": "\\b(abs|acos|adjust_image_opacity|append_file|asin|assert|atan|atan2|breakpoint|busy|ceil|clamp|composite_image|contains|context|convert_image|copy_file|cos|crop_image|current_dir|datastore|debug|decode_base64|decrypt|deep_copy|doc|ec_from_jwk|encode_base64|encrypt|ends_with|env|error|exit|exp|fetch|fibonacci|file_exists|file_type|filter|find|flip_image_x|flip_image_y|floor|format_csv|format_json|format_time|grayscale_image|hash|hash_password|hmac|http_server|include|input|join|keys|kill|len|list_dir|list_files|ln|load|load_binary|load_image|log|lower|make_dir|map|markdown_ansi|markdown_html|markdown_text|max|min|move_file|now|pad_left|pad_right|parallel|parse|parse_csv|parse_json|parse_time|pi|pop|pow|print|push|random|range|reduce|remove_dir|remove_file|rename_file|repeat|replace|require|rotate_image|round|rsa_from_jwk|run|save|save_binary|save_image|scale_image|send_websocket|set_image_opacity|shift|sign_ec|sign_rsa|sin|sleep|sort|spawn|split|sql|sqrt|starts_with|substr|sys|tan|template|throw|timer|timestamp|tobool|tonumber|toregex|tostring|trim|type|unshift|upper|uuid|values|verify_ec|verify_ed25519|verify_password|verify_rsa|watch|websocket|write)\\b",
          "name": "support.function.duso"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.duso"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.duso"
            }
          },
          "name": "comment.block.duso",
          "patterns": [
            {
              "begin": "/\\*",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.comment.begin.duso"
                }
              },
              "end": "\\*/",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.comment.end.duso"
                }
              },
              "name": "comment.block.duso"
            }
          ]
        },
        {
          "match": "//.*?$",
          "name": "comment.line.duso"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(true|false|nil)\\b",
          "name": "constant.language.duso"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "keyword.control.duso"
            },
            "2": {
              "name": "entity.name.function.duso"
            }
          },
          "match": "\\b(function)\\s+([a-z_][a-z0-9_]*)\\b",
          "name": "meta.function.duso"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "match": "\\b[a-z_][a-z0-9_]*\\b",
          "name": "variable.other.duso"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(and|break|catch|continue|do|else|elseif|end|false|for|function|if|in|nil|not|or|raw|return|then|true|try|var|while)\\b",
          "name": "keyword.control.duso"
        }
      ]
    },
    "multiline-strings": {
      "patterns": [
        {
          "applyEndPatternLast": true,
          "begin": "\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.bracket.multiline.begin.duso"
            }
          },
          "contentName": "string.quoted.double.duso",
          "end": "\"\"\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.bracket.multiline.end.duso"
            }
          },
          "patterns": [
            {
              "include": "#template-expression"
            }
          ]
        },
        {
          "applyEndPatternLast": true,
          "begin": "'''",
          "beginCaptures": {
            "0": {
              "name": "punctuation.bracket.multiline.begin.duso"
            }
          },
          "contentName": "string.quoted.single.duso",
          "end": "'''",
          "endCaptures": {
            "0": {
              "name": "punctuation.bracket.multiline.end.duso"
            }
          },
          "patterns": [
            {
              "include": "#template-expression"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b([0-9]+(\\.[0-9]+)?)\\b",
          "name": "constant.numeric.duso"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "(==|!=|\u003c=|\u003e=|\u003c|\u003e)",
          "name": "keyword.operator.comparison.duso"
        },
        {
          "match": "(\\+=|-=|\\*=|/=|%=|=)",
          "name": "keyword.operator.assignment.duso"
        },
        {
          "match": "(\\+|-|\\*|/|%)",
          "name": "keyword.operator.arithmetic.duso"
        },
        {
          "match": "(\\+\\+|--)",
          "name": "keyword.operator.postfix.duso"
        },
        {
          "match": "[?:]",
          "name": "keyword.operator.ternary.duso"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "[{}\\[\\]().,;]",
          "name": "punctuation.duso"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "~",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.regexp.begin.duso"
            }
          },
          "end": "~",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.regexp.end.duso"
            }
          },
          "name": "source.regexp.duso",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.regexp.duso"
            }
          ]
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.duso",
          "patterns": [
            {
              "match": "\\\\([\\\\\"'ntr{}])",
              "name": "constant.character.escape.duso"
            },
            {
              "include": "#template-expression"
            }
          ]
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.duso",
          "patterns": [
            {
              "match": "\\\\([\\\\\"'ntr{}])",
              "name": "constant.character.escape.duso"
            },
            {
              "include": "#template-expression"
            }
          ]
        }
      ]
    },
    "structures": {
      "patterns": [
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.duso"
        }
      ]
    },
    "template-expression": {
      "patterns": [
        {
          "begin": "{{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.template.begin.duso"
            }
          },
          "end": "}}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.template.end.duso"
            }
          },
          "name": "meta.template.duso",
          "patterns": [
            {
              "include": "#builtins"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#identifiers"
            },
            {
              "include": "#punctuation"
            }
          ]
        }
      ]
    }
  },
  "scopeName": "source.duso"
}
